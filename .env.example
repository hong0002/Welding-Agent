# UTF-8. Copy to root .env, fill local paths, never commit it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
WELD_AGENT_ENABLED=true
WELD_AGENT_REASONING_EFFORT=low

# Root of 3.개방데이터, with both 1.데이터/Other and 2.데이터(NIA).
WELD_DATASET_ROOT=
# Explicit native Python 3.12 executable; separate from backend/Isaac Python.
WELD_NATIVE_PYTHON=

# Native Mask / Trajectory3. Run scripts/configure_release.py first.
WELD_SEGMENT_BACKEND=native_v2
WELD_SEGMENT_CONFIG=.cache/native-integration/configs/segment2.windows.yaml
WELD_SEGMENT_NATIVE_BINDING=.cache/native-integration/configs/binding.json
WELD_ROUGH_BACKEND=dummy
WELD_ROUGH3D_BACKEND=native_3d_v3
WELD_ROUGH3D_CONFIG=.cache/native-integration/configs/trajectory3.windows.yaml
WELD_ROUGH3D_NATIVE_BINDING=.cache/native-integration/configs/binding.json
# Backend-owned source roots default to modules/. Optional explicit overrides:
WELD_SEGMENT_REPO=
WELD_ROUGH3D_REPO=

# Operator SSH alias/config used by native Mask/Trajectory3 YOLO + retrieval.
# No connection is started by setup or tests. Final retrieval is LOCAL below.
WELD_NATIVE_SSH_ALIAS=
WELD_NATIVE_REMOTE_ROOT=
WELD_NATIVE_REMOTE_PYTHON=
WELD_NATIVE_YOLO_PYTHON=

# Final production selector; no RICL/baseline required for prediction-only.
WELD_FINAL_TRAJECTORY_BACKEND=gpt2
WELD_GPT2_TRAJECTORY_ROOT=
WELD_GPT2_TRAJECTORY_CONFIG=modules/vlm_final_gpt2/config.yaml
WELD_GPT2_SHARED_ROOT=
WELD_GPT2_RETRIEVAL_MODE=local
WELD_GPT2_LOCAL_RETRIEVAL_ROOT=
# Existing encoder cache; if empty, use .cache/model-encoders/hub.
WELD_GPT2_ENCODER_CACHE=

# Independent simulation only. Explicit Isaac launcher required.
WELD_SIM_BACKEND=dataset_final
WELD_SIM_FINAL_ROOT=
WELD_SIM_LAUNCHER=
# Optional rollback (requires its separate external source/assets).
WELD_SIM_STP_ROOT=
WELD_SIM_STP_MODE=stp
