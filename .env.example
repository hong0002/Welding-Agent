# Optional backend settings (uvicorn --env-file .env).
WELD_STORAGE_DIR=backend/storage
WELD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# Components smaller than this pixel area are excluded from planning (original mask preserved).
WELD_MIN_COMPONENT_AREA=16
# Vite proxies /api to this address. Set before npm run dev if needed.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
# The 2D preview needs no model or API key. The optional simulator uses existing local data.
# Root defaults to sibling ../simulator. Use forward slashes for Windows dotenv paths.
WELD_SIM_ROOT=
# REQUIRED to start: existing Isaac launcher (.bat/.cmd/.exe).
# Windows standalone example: D:/isaacsim/python.bat (initializes the Isaac environment).
WELD_SIM_LAUNCHER=
# Deprecated optional fallback when WELD_SIM_LAUNCHER is blank. Never infer backend Python.
WELD_SIM_PYTHON=
# REQUIRED to run a sample: select an existing exported VLA episode, e.g. L_PR_03_0001.
# There is no automatic selection or fallback to GT.
WELD_SIM_SAMPLE_ID=
# Blank uses the external scripts' original defaults relative to simulator root:
# ../../42.용접로봇 행동 생성 데이터/3.개방데이터 and ../../welding_validation_all
WELD_SIM_DATA_ROOT=
# Extracted H5/OBJ tree. Overrides --data-root with the original --samples-dir option.
# This PC: D:/연구/sim/Datase/other_data/Other/Other/로봇티칭데이터
WELD_SIM_SAMPLES_DIR=
WELD_SIM_PREDICTION_ROOT=
# metadata (normal exports), or legacy_npz (explicit H5-verified cache adapter).
# This PC's D:/연구/sim/welding_validation_all needs legacy_npz; originals stay unchanged.
WELD_SIM_PREDICTION_FORMAT=metadata
WELD_SIM_STARTUP_TIMEOUT=180
WELD_SIM_SAMPLE_TIMEOUT=300
WELD_SIM_DURATION=15
# Current Web VLA Preview only. Existing sample replay always retains WELD_SIM_ROOT.
# Default remains legacy; dataset_v2 rollback is explicit. No automatic fallback.
WELD_SIM_BACKEND=legacy
WELD_SIM2_ROOT=../simulator2
# Optional dataset_stp candidate: exact sample OBJ + native STP reference layout.
# Root .env activation is explicit; no automatic v2 fallback.
# See docs/simulator-stp-integration.md for offline evidence/manual GUI smoke.
WELD_SIM_STP_ROOT=../simulator_stp
# Actual native option is --layout stp, not --mode stp.
WELD_SIM_STP_MODE=stp
# simulator2's native math uses the audited non-Isaac Python and repository-owned
# .cache/simulator2/python-deps (trimesh/rtree); no installed Isaac changes.

# Optional GPT conversational orchestration (the manual preview still works without a key).
# The backend reads the secret only from this project's root .env. Never use VITE_ for secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
WELD_AGENT_ENABLED=true
WELD_AGENT_MAX_TURNS=8
# NativeRough2D baseline stops at Rough; Dummy retains the existing Dummy VLA preview.
WELD_SEGMENT_BACKEND=dummy
# Explicit migration candidate: native_v2; rollback: native_v1. No automatic fallback.
# Candidate REPO=../vlm_segment2, CONFIG=.cache/native-integration/configs/segment2.windows.yaml
WELD_ROUGH_BACKEND=dummy
# Native launches only the parity-verified Python and original sibling repositories.
WELD_SEGMENT_PYTHON=C:/Users/hong_/anaconda3/envs/py3_12/python.exe
WELD_ROUGH_PYTHON=C:/Users/hong_/anaconda3/envs/py3_12/python.exe
WELD_SEGMENT_REPO=
WELD_ROUGH_REPO=
# Backend-owned Windows configs and explicit sample/view/image binding; see docs/models.md.
WELD_SEGMENT_CONFIG=.cache/native-integration/configs/segment.windows.yaml
WELD_ROUGH_CONFIG=.cache/native-integration/configs/rough.windows.yaml
WELD_SEGMENT_NATIVE_BINDING=.cache/native-integration/configs/binding.json
WELD_ROUGH_NATIVE_BINDING=.cache/native-integration/configs/binding.json
# Native always uses native retrieval. none/fixed are experimental-only and never a fallback.
WELD_SEGMENT_REFERENCE_MODE=native
WELD_ROUGH_REFERENCE_MODE=native
WELD_SEGMENT_TIMEOUT=900
WELD_ROUGH_TIMEOUT=900
WELD_AGENT_RUN_TIMEOUT=1200

# Dataset scenes default to native_3d; web Path panel explicitly selects the 2D baseline.
# Blank dataset root uses the existing owned guided-vla-inputs.json dataset_root.
WELD_DATASET_ROOT=
WELD_ROUGH3D_BACKEND=native
# Explicit migration candidate: native_3d_v3; rollback: native_3d_v2.
# Candidate REPO=../vlm_trajectory3, CONFIG=.cache/native-integration/configs/trajectory3.windows.yaml
WELD_ROUGH3D_PYTHON=C:/Users/hong_/anaconda3/envs/py3_12/python.exe
WELD_ROUGH3D_CONFIG=.cache/native-integration/configs/rough3d.windows.yaml
WELD_ROUGH3D_NATIVE_BINDING=.cache/native-integration/configs/binding.json
WELD_ROUGH3D_TIMEOUT=900
# Guided VLA: backend-only settings. Explicit web action/semantic tool or CLI --live.
# Never use the backend's own port here; this deployment uses SSH tunnel port 18000.
WELD_GUIDED_VLA_SERVER_URL=http://127.0.0.1:8000
WELD_GUIDED_VLA_API_TOKEN=
WELD_GUIDED_VLA_TIMEOUT=600
WELD_GUIDED_VLA_INPUTS=.cache/native-models/guided-vla-inputs.json
